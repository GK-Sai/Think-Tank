# Copy to .env and edit. Nothing here is read until you do.

# --- database -------------------------------------------------------------
# Matches docker-compose.yml. Note the +asyncpg — a plain postgresql:// URL
# will fail at startup because the engine is async.
DATABASE_URL=postgresql+asyncpg://thinktank:thinktank@localhost:5432/thinktank

# --- auth -----------------------------------------------------------------
# The access token is a JWT the frontend holds and sends as
# `Authorization: Bearer <token>`.
# Generate a secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everybody out, which is exactly what you want if it leaks.
SECRET_KEY=change-me-before-you-deploy-this-anywhere
SESSION_DAYS=14

# --- cors -----------------------------------------------------------------
# The token is a header, not a cookie, so these are not credentialed requests
# and "*" would be allowed. Name the front ends anyway.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# The shared password new members are created with.
DEFAULT_MEMBER_PASSWORD=tt123
