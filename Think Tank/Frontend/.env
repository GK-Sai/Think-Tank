# The backend exists now, so the app talks to it.
# Flip this back to true to run on the seeded demo data in the browser.
VITE_USE_MOCK=false

# Left empty on purpose: calls go to the page's own origin and the Vite proxy
# in vite.config.js forwards /api to http://localhost:8000, so CORS never
# comes into it in development. Set an absolute URL to call a deployed API.
VITE_API_URL=
